@model WebSiteBanHang.Models.ViewModels.PaginatedList<WebSiteBanHang.Models.Category>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary">
            <i class="bi bi-list"></i> Các Danh Mục
        </h2>
        <a asp-action="Add" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add New Category
        </a>
    </div>

    <!-- Search Bar -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-2 align-items-center">
                <div class="col-md-9">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0">
                            <i class="bi bi-search text-primary"></i>
                        </span>
                        <input type="text" name="searchTerm" class="form-control border-start-0" 
                               placeholder="Tìm kiếm danh mục..." value="@ViewBag.SearchTerm">
                        <button class="btn btn-primary" type="submit">Tìm kiếm</button>
                    </div>
                </div>
                <div class="col-md-3 text-end">
                    @if (!string.IsNullOrEmpty(ViewBag.SearchTerm as string))
                    {
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle"></i> Xóa tìm kiếm
                        </a>
                    }
                </div>
                <input type="hidden" name="page" value="1" />
            </form>
        </div>
    </div>

    <div class="card shadow">
        <div class="card-body">
            @if (Model.Items.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-primary">
                            <tr>
                                <th scope="col">Name</th>
                                <th scope="col" class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var category in Model.Items)
                            {
                                <tr>
                                    <td>
                                        <strong>@category.Name</strong>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Update" asp-route-id="@category.Id"
                                               class="btn btn-outline-warning btn-sm" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@category.Id"
                                               class="btn btn-outline-danger btn-sm" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Page navigation">
                        <ul class="pagination justify-content-center mt-4">
                            <!-- First Page -->
                            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                                <a class="page-link" asp-action="Index" asp-route-page="1" asp-route-searchTerm="@ViewBag.SearchTerm" aria-label="First">
                                    <span aria-hidden="true">&laquo;&laquo;</span>
                                </a>
                            </li>
                            <!-- Previous Page -->
                            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageIndex - 1)" asp-route-searchTerm="@ViewBag.SearchTerm" aria-label="Previous">
                                    <span aria-hidden="true">&laquo;</span>
                                </a>
                            </li>
                            
                            @{
                                var startPage = Math.Max(1, Model.PageIndex - 2);
                                var endPage = Math.Min(Model.TotalPages, Model.PageIndex + 2);
                                
                                // Show dots if not starting from first page
                                if (startPage > 1)
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">...</span>
                                    </li>
                                }
                                
                                // Page numbers
                                for (var i = startPage; i <= endPage; i++)
                                {
                                    <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                        <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-searchTerm="@ViewBag.SearchTerm">@i</a>
                                    </li>
                                }
                                
                                // Show dots if not ending on last page
                                if (endPage < Model.TotalPages)
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">...</span>
                                    </li>
                                }
                            }
                            
                            <!-- Next Page -->
                            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageIndex + 1)" asp-route-searchTerm="@ViewBag.SearchTerm" aria-label="Next">
                                    <span aria-hidden="true">&raquo;</span>
                                </a>
                            </li>
                            <!-- Last Page -->
                            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                                <a class="page-link" asp-action="Index" asp-route-page="@Model.TotalPages" asp-route-searchTerm="@ViewBag.SearchTerm" aria-label="Last">
                                    <span aria-hidden="true">&raquo;&raquo;</span>
                                </a>
                            </li>
                        </ul>
                    </nav>
                    
                    <div class="text-center mt-2 text-muted small">
                        Showing @(((Model.PageIndex - 1) * Model.PageSize) + 1) to @(Math.Min(Model.TotalItems, Model.PageIndex * Model.PageSize)) of @Model.TotalItems items
                    </div>
                }
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-folder2 text-muted fs-1"></i>
                    @if (!string.IsNullOrEmpty(ViewBag.SearchTerm as string))
                    {
                        <h5 class="mt-3">Không tìm thấy danh mục nào</h5>
                        <p class="text-muted">Không tìm thấy danh mục khớp với từ khóa "@ViewBag.SearchTerm"</p>
                        <a asp-action="Index" class="btn btn-outline-primary mt-2">
                            <i class="bi bi-arrow-left me-2"></i>Xem tất cả danh mục
                        </a>
                    }
                    else
                    {
                        <h5 class="mt-3">Chưa có danh mục nào</h5>
                        <p class="text-muted">Bạn có thể thêm danh mục mới bằng cách nhấn vào nút phía trên.</p>
                        <a asp-action="Add" class="btn btn-primary mt-2">
                            <i class="bi bi-plus-circle me-2"></i>Thêm danh mục mới
                        </a>
                    }
                </div>
            }
        </div>
    </div>
</div>

<script>
    // Auto-submit search form when pressing Enter key
    document.addEventListener('DOMContentLoaded', function() {
        const searchInput = document.querySelector('input[name="searchTerm"]');
        
        if(searchInput) {
            searchInput.addEventListener('keypress', function(event) {
                if (event.key === 'Enter') {
                    event.preventDefault();
                    this.form.submit();
                }
            });
        }
    });
</script>



