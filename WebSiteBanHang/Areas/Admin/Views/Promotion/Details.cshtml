@model WebSiteBanHang.Models.Promotion

@{
    ViewData["Title"] = "Chi tiết mã khuyến mãi";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center my-4">
        <div>
            <h1 class="mb-0 fw-bold">@ViewData["Title"]</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 mt-2">
                    <li class="breadcrumb-item"><a href="/Admin/Admin/Index" class="text-decoration-none"><i class="fas fa-home"></i> Trang chủ</a></li>
                    <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Promotion" asp-action="Index" class="text-decoration-none">Quản lý khuyến mãi</a></li>
                    <li class="breadcrumb-item active">Chi tiết</li>
                </ol>
            </nav>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i> Quay lại danh sách
        </a>
    </div>

    <div class="card mb-4 shadow-sm border-0 rounded-3">
        <div class="card-header bg-gradient text-white py-3" style="background-color: #4e73df;">
            <div class="d-flex align-items-center">
                <i class="fas fa-tags fa-fw me-2"></i>
                <span class="font-weight-bold">Chi tiết mã khuyến mãi: <strong>@Model.Code</strong></span>
            </div>
        </div>
        <div class="card-body p-4">
            <div class="alert alert-light border rounded-3 p-3 mb-4">
                <div class="row align-items-center">
                    <div class="col-auto">
                        <div class="bg-light rounded-circle p-3">
                            <i class="fas fa-percent fa-2x text-primary"></i>
                        </div>
                    </div>
                    <div class="col">
                        <h5 class="mb-1">@Model.Description</h5>
                        <p class="mb-0 text-muted small">Mã được tạo vào @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                    </div>
                    <div class="col-auto">
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success rounded-pill px-3 py-2">
                                <i class="fas fa-check-circle me-1"></i> Đang hoạt động
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary rounded-pill px-3 py-2">
                                <i class="fas fa-times-circle me-1"></i> Đã tắt
                            </span>
                        }
                    </div>
                </div>
            </div>

            <div class="row g-4">
                <!-- Thông tin cơ bản -->
                <div class="col-md-6">
                    <div class="card h-100 border-0 bg-light rounded-3">
                        <div class="card-header bg-light border-0">
                            <h5 class="mb-0"><i class="fas fa-info-circle me-2 text-primary"></i> Thông tin cơ bản</h5>
                        </div>
                        <div class="card-body">
                            <ul class="list-group list-group-flush">
                                <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent px-0 py-3 border-bottom">
                                    <span class="text-muted">Mã khuyến mãi</span>
                                    <span class="fw-bold text-primary">@Model.Code</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent px-0 py-3 border-bottom">
                                    <span class="text-muted">Giá trị giảm</span>
                                    <div>
                                        @if (Model.IsPercentage)
                                        {
                                            <span class="badge bg-primary rounded-pill px-3 py-2">
                                                <i class="fas fa-percentage me-1"></i> @Model.DiscountAmount%
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success rounded-pill px-3 py-2">
                                                <i class="fas fa-money-bill-wave me-1"></i> @Model.DiscountAmount.ToString("#,##0").Replace(",", ".") đ
                                            </span>
                                        }
                                    </div>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent px-0 py-3 border-bottom">
                                    <span class="text-muted">Đơn hàng tối thiểu</span>
                                    <div>
                                        @if (Model.MinimumOrderAmount.HasValue)
                                        {
                                            <span class="badge bg-secondary rounded-pill px-3 py-2">
                                                <i class="fas fa-coins me-1"></i> @Model.MinimumOrderAmount.Value.ToString("#,##0").Replace(",", ".") đ
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark rounded-pill px-3 py-2">
                                                <i class="fas fa-infinity me-1"></i> Không giới hạn
                                            </span>
                                        }
                                    </div>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Thông tin sử dụng -->
                <div class="col-md-6">
                    <div class="card h-100 border-0 bg-light rounded-3">
                        <div class="card-header bg-light border-0">
                            <h5 class="mb-0"><i class="fas fa-chart-line me-2 text-primary"></i> Thông tin sử dụng</h5>
                        </div>
                        <div class="card-body">
                            <ul class="list-group list-group-flush">
                                <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent px-0 py-3 border-bottom">
                                    <span class="text-muted">Thời gian hiệu lực</span>
                                    <div class="text-end">
                                        <div class="d-flex align-items-center justify-content-end">
                                            <i class="fas fa-calendar-alt me-2 text-primary"></i>
                                            <div>
                                                <div>Từ: <strong>@Model.StartDate.ToString("dd/MM/yyyy")</strong></div>
                                                @if (Model.EndDate.HasValue)
                                                {
                                                    <div>Đến: <strong>@Model.EndDate.Value.ToString("dd/MM/yyyy")</strong></div>
                                                }
                                                else
                                                {
                                                    <div>Đến: <span class="text-muted">Không giới hạn</span></div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent px-0 py-3 border-bottom">
                                    <span class="text-muted">Giới hạn sử dụng</span>
                                    <div>
                                        @if (Model.MaxUseTimes.HasValue)
                                        {
                                            <div class="text-end">
                                                <div class="fw-bold mb-1">@Model.UsedTimes / @Model.MaxUseTimes.Value lần</div>
                                                <div class="progress" style="height: 8px; width: 120px;">
                                                    <div class="progress-bar bg-info" role="progressbar" 
                                                        style="width: @(Math.Min(100, (Model.UsedTimes * 100 / Math.Max(1, Model.MaxUseTimes.Value))))%;" 
                                                        aria-valuenow="@Model.UsedTimes" aria-valuemin="0" aria-valuemax="@Model.MaxUseTimes">
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark rounded-pill px-3 py-2">
                                                <i class="fas fa-infinity me-1"></i> Đã dùng @Model.UsedTimes lần
                                            </span>
                                        }
                                    </div>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent px-0 py-3">
                                    <span class="text-muted">Ngày tạo</span>
                                    <span class="fw-bold">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-center mt-4 gap-2">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary px-4">
                    <i class="fas fa-edit me-2"></i> Chỉnh sửa
                </a>
                <a asp-action="Index" class="btn btn-secondary px-4">
                    <i class="fas fa-arrow-left me-2"></i> Quay lại
                </a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger px-4">
                    <i class="fas fa-trash-alt me-2"></i> Xóa
                </a>
            </div>
        </div>
    </div>
</div> 