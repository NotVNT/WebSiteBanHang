@model WebSiteBanHang.Models.ViewModels.PaginatedList<WebSiteBanHang.Models.Rating>
@{
    ViewData["Title"] = "Quản Lý Đánh Giá & Bình Luận";
    
    var averageRating = ViewBag.AverageRating != null ? Math.Round((double)ViewBag.AverageRating, 1) : 0;
    var ratingStats = ViewBag.RatingStats as Dictionary<int, int> ?? new Dictionary<int, int>();
    var totalRatings = ViewBag.TotalRatings ?? 0;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary">
            <i class="bi bi-chat-square-text"></i> Quản Lý Đánh Giá & Bình Luận
        </h2>
        @if (ViewData["FilteredProductId"] != null)
        {
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-x-circle"></i> Xóa bộ lọc
            </a>
        }
    </div>
    
    <!-- Ratings Overview -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle bg-primary bg-opacity-10 p-3 me-3">
                            <i class="bi bi-chat-dots text-primary fs-3"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1">Tổng số đánh giá</h6>
                            <h3 class="mb-0">@totalRatings</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle bg-warning bg-opacity-10 p-3 me-3">
                            <i class="bi bi-star-half text-warning fs-3"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1">Đánh giá trung bình</h6>
                            <h3 class="mb-0">@averageRating <small class="text-muted fs-6">/5</small></h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle bg-success bg-opacity-10 p-3 me-3">
                            <i class="bi bi-graph-up text-success fs-3"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1">Đánh giá cao nhất</h6>
                            <h3 class="mb-0">@(ratingStats.GetValueOrDefault(5, 0)) <small class="text-muted fs-6">5 sao</small></h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Star Rating Distribution -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-3">
                    <h5 class="mb-3"><i class="bi bi-bar-chart-fill text-primary me-2"></i>Phân bố đánh giá</h5>
                    <div class="table-responsive">
                        <table class="table mb-0">
                            <tbody>
                                @for (int i = 5; i >= 1; i--)
                                {
                                    var count = ratingStats.GetValueOrDefault(i, 0);
                                    var percentage = totalRatings > 0 ? (count * 100.0 / totalRatings) : 0;
                                    
                                    <tr>
                                        <td style="width: 80px">
                                            <div class="d-flex align-items-center">
                                                <span class="me-2">@i</span>
                                                @for (int j = 0; j < i; j++)
                                                {
                                                    <i class="bi bi-star-fill text-warning"></i>
                                                }
                                            </div>
                                        </td>
                                        <td style="width: 60%">
                                            <div class="progress" style="height: 10px">
                                                <div class="progress-bar bg-warning" role="progressbar" 
                                                     style="width: @percentage%;" 
                                                     aria-valuenow="@percentage" aria-valuemin="0" aria-valuemax="100"></div>
                                            </div>
                                        </td>
                                        <td class="text-end"><strong>@count</strong> <span class="text-muted">(@percentage.ToString("0.0")%)</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    @if (ViewData["FilteredProductId"] != null)
    {
        <div class="alert alert-info mb-4">
            <h5 class="mb-0">
                <i class="bi bi-funnel"></i> Đang lọc theo:
                <strong>@ViewData["FilteredProductName"]</strong>
            </h5>
        </div>
    }

    <div class="card shadow mb-4">
        <div class="card-body">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (Model.Items.Any())
            {
                <!-- Sort options -->
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <div class="btn-group">
                            <a asp-action="Index" asp-route-sortOrder="@ViewData["DateSortParam"]" 
                               asp-route-productId="@ViewData["FilteredProductId"]"
                               class="btn @(String.IsNullOrEmpty((string)ViewData["CurrentSort"]) || (string)ViewData["CurrentSort"] == "date_asc" ? "btn-primary" : "btn-outline-primary")">
                                <span class="d-flex align-items-center">
                                    <i class="bi bi-calendar me-2"></i> Ngày
                                </span>
                            </a>
                            <a asp-action="Index" asp-route-sortOrder="@ViewData["RatingSortParam"]"
                               asp-route-productId="@ViewData["FilteredProductId"]"
                               class="btn @((string)ViewData["CurrentSort"] == "rating" || (string)ViewData["CurrentSort"] == "rating_desc" ? "btn-primary" : "btn-outline-primary")">
                                <span class="d-flex align-items-center">
                                    <i class="bi bi-star me-2"></i> Đánh giá
                                </span>
                            </a>
                        </div>
                    </div>
                    <div class="text-muted">
                        Hiển thị @Model.Items.Count() / @Model.TotalItems đánh giá
                    </div>
                </div>

                <!-- Ratings list -->
                <div class="list-group">
                    @foreach (var rating in Model.Items)
                    {
                        <div class="list-group-item border-0 border-bottom">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <h5 class="mb-1">
                                        <a asp-area="Admin" asp-controller="Product" asp-action="Display" asp-route-id="@rating.ProductId" class="text-decoration-none">
                                            @rating.Product.Name
                                        </a>
                                    </h5>
                                    <div class="d-flex align-items-center">
                                        <div class="rating-stars me-2">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= rating.RatingValue)
                                                {
                                                    <i class="bi bi-star-fill text-warning"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-star text-warning"></i>
                                                }
                                            }
                                        </div>
                                        <small class="text-muted">
                                            <i class="bi bi-person"></i> @rating.User.FullName • 
                                            <i class="bi bi-calendar"></i> @rating.DateCreated.ToString("dd/MM/yyyy HH:mm")
                                        </small>
                                    </div>
                                </div>
                                <div class="d-flex">
                                    <a asp-action="Index" asp-route-productId="@rating.ProductId" class="btn btn-sm btn-outline-primary me-2" 
                                       title="Lọc theo sản phẩm này">
                                        <i class="bi bi-funnel"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@rating.Id" method="post" 
                                          onsubmit="return confirm('Bạn có chắc chắn muốn xóa đánh giá này không?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa đánh giá">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                            
                            @if (!string.IsNullOrWhiteSpace(rating.Comment))
                            {
                                <p class="mb-0 border-start ps-3 py-1">@rating.Comment</p>
                            }
                            else
                            {
                                <p class="mb-0 text-muted fst-italic"><small>Không có bình luận</small></p>
                            }
                        </div>
                    }
                </div>

                <!-- Pagination -->
                <nav class="mt-4">
                    <ul class="pagination justify-content-center">
                        <!-- First Page -->
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Index" asp-route-page="1" 
                               asp-route-sortOrder="@ViewData["CurrentSort"]"
                               asp-route-productId="@ViewData["FilteredProductId"]" aria-label="First">
                                <span aria-hidden="true">&laquo;&laquo;</span>
                            </a>
                        </li>
                        <!-- Previous Page -->
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageIndex - 1)" 
                               asp-route-sortOrder="@ViewData["CurrentSort"]"
                               asp-route-productId="@ViewData["FilteredProductId"]" aria-label="Previous">
                                <span aria-hidden="true">&laquo;</span>
                            </a>
                        </li>
                        
                        @{
                            const int totalVisiblePages = 5;
                            var startPage = Math.Max(1, Model.PageIndex - totalVisiblePages / 2);
                            var endPage = Math.Min(Model.TotalPages, startPage + totalVisiblePages - 1);
                            
                            // Adjust startPage if we're near the end to show consistent number of pages
                            if (endPage - startPage + 1 < totalVisiblePages && startPage > 1)
                            {
                                startPage = Math.Max(1, endPage - totalVisiblePages + 1);
                            }
                            
                            // Show ellipsis if needed
                            if (startPage > 1)
                            {
                                <li class="page-item disabled">
                                    <span class="page-link">...</span>
                                </li>
                            }
                            
                            // Show page numbers
                            for (int i = startPage; i <= endPage; i++)
                            {
                                <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-page="@i" 
                                       asp-route-sortOrder="@ViewData["CurrentSort"]"
                                       asp-route-productId="@ViewData["FilteredProductId"]">@i</a>
                                </li>
                            }
                            
                            // Show ending ellipsis if needed
                            if (endPage < Model.TotalPages)
                            {
                                <li class="page-item disabled">
                                    <span class="page-link">...</span>
                                </li>
                            }
                        }
                        
                        <!-- Next Page -->
                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageIndex + 1)" 
                               asp-route-sortOrder="@ViewData["CurrentSort"]"
                               asp-route-productId="@ViewData["FilteredProductId"]" aria-label="Next">
                                <span aria-hidden="true">&raquo;</span>
                            </a>
                        </li>
                        <!-- Last Page -->
                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Index" asp-route-page="@Model.TotalPages" 
                               asp-route-sortOrder="@ViewData["CurrentSort"]"
                               asp-route-productId="@ViewData["FilteredProductId"]" aria-label="Last">
                                <span aria-hidden="true">&raquo;&raquo;</span>
                            </a>
                        </li>
                    </ul>
                </nav>
            }
            else
            {
                <div class="text-center py-5">
                    <div class="mb-3">
                        <i class="bi bi-chat-square-x fs-1 text-muted"></i>
                    </div>
                    <h4>Không tìm thấy đánh giá nào</h4>
                    @if (ViewData["FilteredProductId"] != null)
                    {
                        <p class="text-muted">Không tìm thấy đánh giá nào cho sản phẩm bạn đã chọn.</p>
                        <a asp-action="Index" class="btn btn-outline-primary mt-2">
                            <i class="bi bi-arrow-left me-2"></i>Xem tất cả đánh giá
                        </a>
                    }
                    else
                    {
                        <p class="text-muted">Chưa có đánh giá nào từ khách hàng.</p>
                    }
                </div>
            }
        </div>
    </div>
</div>

<style>
    .rounded-4 {
        border-radius: 0.75rem !important;
    }
    
    .rating-stars {
        color: #ffc107;
    }
</style> 