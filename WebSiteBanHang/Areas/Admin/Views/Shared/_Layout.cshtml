<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AdminPanel</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebSiteBanHang.styles.css" asp-append-version="true" />
    <style>
        .logout-message {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 1050;
            width: 50%;
            text-align: center;
        }

        /* Sticky header styles */
        header.sticky-top {
            position: sticky;
            top: 0;
            z-index: 1000;
            width: 100%;
            transition: all 0.3s ease;
        }
        
        /* Add shadow when scrolled */
        header.shadow-on-scroll {
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        }
    </style>
</head>
<body class="bg-light">
    <header class="sticky-top">
        <nav class="navbar navbar-expand-sm navbar-dark bg-primary shadow-sm">
            <div class="container">
                <a class="navbar-brand" asp-area="Admin" asp-controller="Admin" asp-action="Index">
                    <i class="bi bi-shield-lock-fill"></i> AdminPanel
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Customer" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house"></i> Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Admin" asp-controller="Product" asp-action="Index">
                                <i class="bi bi-box"></i> Products
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Admin" asp-controller="Categories" asp-action="Index">
                                <i class="bi bi-shield-check"></i> Categories
                            </a>
                        </li>
                    </ul>
                    
                    <!-- Search Bar -->
                    <form class="d-flex mx-auto" asp-area="Customer" asp-controller="Product" asp-action="Search" method="get">
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0">
                                <i class="bi bi-search text-muted"></i>
                            </span>
                            <input type="text" name="searchTerm" id="adminSearchInput" class="form-control border-start-0 border-end-0" 
                                   placeholder="Tìm kiếm sản phẩm..." aria-label="Search products">
                            <span class="input-group-text bg-white border-start-0 clear-search-icon" onclick="clearSearch('adminSearchInput')">
                                <i class="bi bi-x text-muted"></i>
                            </span>
                        </div>
                    </form>
                    
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        @if (TempData["LogoutMessage"] != null)
        {
            <div class="alert alert-info logout-message">
                @TempData["LogoutMessage"]
            </div>
        }
        
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer border-top py-3 mt-4 bg-white">
        <div class="container text-center">
            <span class="text-muted">&copy; 2025 - WebSiteBanHang - </span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        function clearSearch(inputId) {
            document.getElementById(inputId).value = '';
            document.getElementById(inputId).focus();
        }
        
        document.addEventListener('DOMContentLoaded', function() {
            const header = document.querySelector('header.sticky-top');
            if (header) {
                window.addEventListener('scroll', function() {
                    if (window.scrollY > 50) {
                        header.classList.add('shadow-on-scroll');
                    } else {
                        header.classList.remove('shadow-on-scroll');
                    }
                });
            }
            
            // Handle search form submit on Enter
            const searchInput = document.getElementById('adminSearchInput');
            if (searchInput) {
                searchInput.addEventListener('keypress', function(e) {
                    if (e.key === 'Enter') {
                        this.form.submit();
                    }
                });
            }
            
            // Add style for clear search icon
            const style = document.createElement('style');
            style.innerHTML = `
                .clear-search-icon {
                    cursor: pointer;
                }
                .clear-search-icon:hover {
                    color: #0d6efd;
                }
            `;
            document.head.appendChild(style);
        });
    </script>
</body>
</html>
