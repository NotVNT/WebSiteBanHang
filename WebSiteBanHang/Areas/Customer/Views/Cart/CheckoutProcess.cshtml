@model WebSiteBanHang.Models.ViewModels.MockCheckoutViewModel
@{
    ViewData["Title"] = "Thông tin đặt hàng";
}

<div class="container py-5">
    <div class="row">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="card-title mb-0">
                        <i class="bi bi-person-lines-fill me-2"></i>Thông tin đặt hàng
                    </h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="PlaceOrder" method="post" class="needs-validation" novalidate>
                        <div asp-validation-summary="ModelOnly" class="text-danger alert alert-danger p-2"></div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="FullName" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                                    <input asp-for="FullName" class="form-control" placeholder="Nhập họ tên..." />
                                </div>
                                <span asp-validation-for="FullName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="PhoneNumber" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                                    <input asp-for="PhoneNumber" class="form-control" placeholder="Nhập 10 hoặc 11 chữ số" />
                                </div>
                                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Email" class="form-control" placeholder="Nhập địa chỉ Gmail" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ShippingAddress" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-geo-alt"></i></span>
                                <textarea asp-for="ShippingAddress" class="form-control" rows="3" placeholder="Nhập địa chỉ giao hàng..."></textarea>
                            </div>
                            <span asp-validation-for="ShippingAddress" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Notes" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-pencil"></i></span>
                                <textarea asp-for="Notes" class="form-control" rows="2" placeholder="Ghi chú về đơn hàng (nếu có)..."></textarea>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PromotionCode" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-percent"></i></span>
                                <input asp-for="PromotionCode" class="form-control" placeholder="Nhập mã giảm giá (nếu có)..." />
                                <button type="button" id="btnApplyPromotion" class="btn btn-outline-primary">
                                    <i class="bi bi-check-lg"></i> Áp dụng
                                </button>
                            </div>
                            <div id="promotionFeedback" class="mt-2"></div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="PaymentMethod" class="form-label"></label>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="form-check card p-3">
                                        <input class="form-check-input" type="radio" asp-for="PaymentMethod" id="cod" value="COD" checked />
                                        <label class="form-check-label" for="cod">
                                            <div class="d-flex align-items-center">
                                                <div class="bg-light rounded-circle p-2 me-3">
                                                    <i class="bi bi-cash text-success fs-4"></i>
                                                </div>
                                                <div>
                                                    <h6 class="mb-0">Thanh toán khi nhận hàng</h6>
                                                    <small class="text-muted">Trả tiền mặt khi nhận được hàng</small>
                                                </div>
                                            </div>
                                        </label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-check card p-3">
                                        <input class="form-check-input" type="radio" asp-for="PaymentMethod" id="bank" value="BankTransfer" />
                                        <label class="form-check-label" for="bank">
                                            <div class="d-flex align-items-center">
                                                <div class="bg-light rounded-circle p-2 me-3">
                                                    <i class="bi bi-credit-card text-primary fs-4"></i>
                                                </div>
                                                <div>
                                                    <h6 class="mb-0">Chuyển khoản ngân hàng</h6>
                                                    <small class="text-muted">Chuyển khoản trước khi giao hàng</small>
                                                </div>
                                            </div>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <span asp-validation-for="PaymentMethod" class="text-danger"></span>
                        </div>

                        <input type="hidden" asp-for="TotalAmount" />
                        <input type="hidden" asp-for="DiscountAmount" id="DiscountAmount" />

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-2"></i>Quay lại giỏ hàng
                            </a>
                            <button type="submit" class="btn btn-success btn-lg px-5">
                                <i class="bi bi-check-circle me-2"></i>Hoàn tất đơn hàng
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm mb-4 sticky-lg-top" style="top: 2rem;">
                <div class="card-header bg-info text-white py-3">
                    <h4 class="card-title mb-0">
                        <i class="bi bi-cart4 me-2"></i>Tóm tắt đơn hàng
                    </h4>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush">
                        @if(Model.CartItems != null && Model.CartItems.Any())
                        {
                            @foreach (var item in Model.CartItems)
                            {
                                <div class="list-group-item p-3">
                                    <div class="d-flex">
                                        <div class="flex-shrink-0 me-3">
                                            <img src="@item.ProductImage" alt="@item.ProductName" class="img-thumbnail" style="width: 60px;">
                                        </div>
                                        <div class="flex-grow-1">
                                            <h6 class="mb-0">@item.ProductName</h6>
                                            <div class="d-flex justify-content-between">
                                                <span class="text-muted">@item.UnitPrice.ToString("N0") đ x @item.Quantity</span>
                                                <span class="fw-bold">@item.Subtotal.ToString("N0") đ</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="list-group-item p-3 text-center">
                                <p class="text-muted mb-0">Không có sản phẩm nào được chọn</p>
                            </div>
                        }
                    </div>
                </div>
                <div class="card-footer bg-light p-3">
                    <div class="d-flex justify-content-between align-items-center fw-bold fs-5 mb-2">
                        <span>Tạm tính:</span>
                        <span>@Model.TotalAmount.ToString("N0") đ</span>
                    </div>
                    
                    <div id="discountRow" class="d-flex justify-content-between align-items-center text-success mb-2 @(Model.DiscountAmount > 0 ? "" : "d-none")">
                        <span><i class="bi bi-tag-fill me-1"></i>Giảm giá:</span>
                        <span>-<span id="discountAmount">@Model.DiscountAmount.ToString("N0")</span> đ</span>
                    </div>
                    
                    <hr>
                    
                    <div class="d-flex justify-content-between align-items-center fw-bold fs-5">
                        <span>Tổng cộng:</span>
                        <span class="text-primary" id="finalAmount">@Model.FinalAmount.ToString("N0") đ</span>
                    </div>
                    
                    <input type="hidden" asp-for="DiscountAmount" id="discountAmountInput" />
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Add this at the top of your script section
        console.log("Initial model values - TotalAmount: @Model.TotalAmount, DiscountAmount: @Model.DiscountAmount");

        // Form validation
        (function () {
            'use strict'
            const forms = document.querySelectorAll('.needs-validation')
            Array.from(forms).forEach(form => {
                form.addEventListener('submit', event => {
                    if (!form.checkValidity()) {
                        event.preventDefault()
                        event.stopPropagation()
                    }
                    form.classList.add('was-validated')
                }, false)
            })
        })()

        // Hiển thị form validation trực tiếp khi người dùng nhập liệu
        $(document).ready(function() {
            // Initialize discount amount if already set
            const initialDiscountAmount = @Model.DiscountAmount;
            if (initialDiscountAmount > 0) {
                $("#discountAmountInput").val(initialDiscountAmount);
                $("#DiscountAmount").val(initialDiscountAmount);
                $("#discountRow").removeClass("d-none");
                $("#discountAmount").text(initialDiscountAmount.toLocaleString('vi-VN'));
                
                // Tính toán lại tổng tiền
                const totalAmount = parseFloat(@Model.TotalAmount.ToString().Replace(",", "."));
                const finalAmount = totalAmount - initialDiscountAmount;
                $("#finalAmount").text(finalAmount.toLocaleString('vi-VN') + " đ");
            }
            
            // Kiểm tra số điện thoại khi nhập
            $("#PhoneNumber").on("input", function() {
                var value = $(this).val();
                // Loại bỏ ký tự không phải số
                value = value.replace(/[^0-9]/g, '');
                $(this).val(value);
                
                // Validate số điện thoại
                if (value.length > 0 && (value.length < 10 || value.length > 11)) {
                    $(this).addClass("is-invalid");
                } else {
                    $(this).removeClass("is-invalid");
                    if (value.length >= 10) {
                        $(this).addClass("is-valid");
                    }
                }
            });

            // Kiểm tra email khi nhập
            $("#Email").on("blur", function() {
                var value = $(this).val();
                var isGmail = /^[a-zA-Z0-9._%+-]+@@gmail\.com$/.test(value);
                
                if (value && !isGmail) {
                    $(this).addClass("is-invalid");
                } else if (value) {
                    $(this).removeClass("is-invalid");
                    $(this).addClass("is-valid");
                }
            });
            
            // Xử lý áp dụng mã giảm giá
            $("#btnApplyPromotion").click(function() {
                // Get the value from the input
                let promoCode = $("#PromotionCode").val();
                
                if (!promoCode) {
                    $("#promotionFeedback").html('<div class="text-danger"><i class="bi bi-exclamation-circle"></i> Vui lòng nhập mã giảm giá</div>');
                    return;
                }
                
                // Ensure code is trimmed of whitespace
                promoCode = promoCode.trim();
                
                $("#promotionFeedback").html('<div class="text-info"><i class="bi bi-hourglass-split"></i> Đang kiểm tra mã...</div>');
                
                // Get the total amount as a number
                const totalAmount = parseFloat('@Model.TotalAmount'.replace(/\./g, '').replace(/,/g, '.'));
                
                // Gọi API kiểm tra mã giảm giá
                $.ajax({
                    url: '/Customer/Cart/ValidatePromotion',
                    type: 'POST',
                    data: { 
                        code: promoCode,
                        amount: totalAmount
                    },
                    success: function(response) {
                        if (response.isValid) {
                            // Lấy thông tin phần trăm giảm giá
                            const discountPercent = response.isPercentage ? response.discountValue : 0;
                            
                            // Tính toán số tiền giảm giá (40% của tạm tính)
                            const discountAmount = Math.round(totalAmount * (discountPercent / 100));
                            
                            // Xóa tất cả thông báo áp dụng mã giảm giá hiện có
                            $(".success-promotion-message").remove();
                            
                            // Hiển thị thông báo thành công CHỈ ở dưới ô nhập mã giảm giá
                            $("#promotionFeedback").html('<div class="success-promotion-message text-success"><i class="bi bi-check-circle"></i> Áp dụng mã giảm giá thành công! ' + discountPercent + '%</div>');
                            
                            // Cập nhật phần hiển thị giảm giá
                            $("#discountAmount").text(discountAmount.toLocaleString('vi-VN'));
                            $("#discountRow").removeClass("d-none");
                            
                            // Cập nhật input ẩn
                            $("#discountAmountInput").val(discountAmount);
                            $("#DiscountAmount").val(discountAmount);
                            
                            // Tính toán số tiền cuối cùng
                            const finalAmount = totalAmount - discountAmount;
                            
                            // Cập nhật hiển thị tổng tiền
                            $("#finalAmount").text(finalAmount.toLocaleString('vi-VN') + " đ");
                            
                            // Thêm hiệu ứng đã thay đổi giá
                            $("#finalAmount").addClass("price-changed");
                            setTimeout(function() {
                                $("#finalAmount").removeClass("price-changed");
                            }, 2000);
                            
                            // Thêm nút xóa mã giảm giá
                            if (!$("#btnRemovePromotion").length) {
                                $("#btnApplyPromotion").after('<button type="button" id="btnRemovePromotion" class="btn btn-outline-danger ms-2"><i class="bi bi-x-lg"></i> Xóa</button>');
                                
                                // Thêm sự kiện cho nút xóa
                                $("#btnRemovePromotion").click(function() {
                                    // Xóa mã giảm giá
                                    $("#PromotionCode").val('');
                                    $("#discountAmountInput").val(0);
                                    $("#DiscountAmount").val(0);
                                    $("#discountRow").addClass("d-none");
                                    
                                    // Xóa thông báo thành công
                                    $(".success-promotion-message").remove();
                                    
                                    // Khôi phục lại giá ban đầu
                                    $("#finalAmount").text(totalAmount.toLocaleString('vi-VN') + " đ");
                                    
                                    // Hiệu ứng
                                    $("#finalAmount").addClass("price-changed");
                                    setTimeout(function() {
                                        $("#finalAmount").removeClass("price-changed");
                                    }, 2000);
                                    
                                    $("#promotionFeedback").html('');
                                    $(this).remove();
                                });
                            }
                        } else {
                            // Hiển thị thông báo lỗi
                            $("#promotionFeedback").html('<div class="text-danger"><i class="bi bi-exclamation-circle"></i> ' + response.message + '</div>');
                            
                            // Xóa tất cả thông báo áp dụng mã giảm giá hiện có
                            $(".success-promotion-message").remove();
                            
                            // Ẩn phần giảm giá
                            $("#discountRow").addClass("d-none");
                            $("#discountAmountInput").val(0);
                            $("#DiscountAmount").val(0);
                            
                            // Khôi phục giá gốc
                            $("#finalAmount").text(totalAmount.toLocaleString('vi-VN') + " đ");
                        }
                    },
                    error: function() {
                        $("#promotionFeedback").html('<div class="text-danger"><i class="bi bi-exclamation-triangle"></i> Có lỗi xảy ra, vui lòng thử lại</div>');
                        // Xóa tất cả thông báo áp dụng mã giảm giá hiện có
                        $(".success-promotion-message").remove();
                    }
                });
            });
        });
    </script>
    
    <style>
        .highlight-discount {
            animation: highlight-fade 2s;
            border-radius: 0.25rem;
        }
        
        @@keyframes highlight-fade {
            0% { background-color: rgba(25, 135, 84, 0.2); }
            100% { background-color: transparent; }
        }
        
        #discountRow {
            transition: all 0.3s ease;
        }
        
        #discountAmount {
            font-weight: bold;
        }
        
        .badge.bg-success {
            animation: badge-pop 0.5s;
        }
        
        @@keyframes badge-pop {
            0% { transform: scale(0.8); opacity: 0; }
            100% { transform: scale(1); opacity: 1; }
        }
        
        .price-changed {
            animation: price-highlight 2s;
            transition: all 0.3s ease;
        }
        
        @@keyframes price-highlight {
            0% { color: #198754; transform: scale(1.05); }
            100% { color: #0d6efd; transform: scale(1); }
        }
    </style>
}
