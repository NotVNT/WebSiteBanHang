@model List<WebSiteBanHang.Models.CartItem>

@{
    ViewData["Title"] = "Giỏ hàng";
    decimal totalPrice = 0;
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <h2 class="mb-4"><i class="bi bi-cart3"></i> Giỏ hàng của bạn</h2>
            
            @if (Model.Count == 0)
            {
                <div class="alert alert-info">
                    <p class="mb-0">Giỏ hàng của bạn đang trống.</p>
                </div>
                <div class="mt-3">
                    <a asp-area="Customer" asp-controller="Home" asp-action="Index" class="btn btn-primary">
                        <i class="bi bi-arrow-left"></i> Tiếp tục mua sắm
                    </a>
                </div>
            }
            else
            {
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover" id="cart-table">
                                <thead class="table-light">
                                    <tr>
                                        <th>
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="selectAll" checked>
                                                <label class="form-check-label" for="selectAll">
                                                    Chọn tất cả
                                                </label>
                                            </div>
                                        </th>
                                        <th>Sản phẩm</th>
                                        <th>Đơn giá</th>
                                        <th>Số lượng</th>
                                        <th class="text-end">Thành tiền</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr class="cart-item-row" data-price="@item.TotalPrice" data-id="@item.Id">
                                            <td>
                                                <div class="form-check">
                                                    <input class="form-check-input item-checkbox" type="checkbox" id="item-@item.Id" value="@item.Id" checked>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    @if (!string.IsNullOrEmpty(item.Product.ImageUrl))
                                                    {
                                                        <img src="@item.Product.ImageUrl" alt="@item.Product.Name" 
                                                            style="width: 60px; height: 60px; object-fit: cover;" class="me-3 border rounded">
                                                    }
                                                    <div>
                                                        <h6 class="mb-0">@item.Product.Name</h6>
                                                        <small class="text-muted">
                                                            @(item.Product.Description?.Length > 30 ? 
                                                              item.Product.Description.Substring(0, 30) + "..." : 
                                                              item.Product.Description)
                                                        </small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>@item.UnitPrice.ToString("C0")</td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <form asp-action="UpdateQuantity" method="post" class="quantity-form">
                                                        <input type="hidden" name="id" value="@item.Id" />
                                                        <div class="input-group" style="width: 120px;">
                                                            <button class="btn btn-sm btn-outline-secondary" type="submit" name="quantity" value="@(item.Quantity - 1)">
                                                                <i class="bi bi-dash"></i>
                                                            </button>
                                                            <input type="text" class="form-control text-center" value="@item.Quantity" readonly>
                                                            <button class="btn btn-sm btn-outline-secondary" type="submit" name="quantity" value="@(item.Quantity + 1)">
                                                                <i class="bi bi-plus"></i>
                                                            </button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </td>
                                            <td class="text-end fw-bold item-total">@item.TotalPrice.ToString("C0")</td>
                                            <td>
                                                <form asp-action="RemoveFromCart" method="post">
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa khỏi giỏ hàng">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="4" class="text-end fw-bold">Tổng cộng:</td>
                                        <td class="text-end fw-bold text-primary fs-5" id="cart-total-price">0</td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-area="Customer" asp-controller="Home" asp-action="Index" class="btn btn-outline-primary">
                        <i class="bi bi-arrow-left"></i> Tiếp tục mua sắm
                    </a>
                    <div>
                        <form id="checkout-form" asp-area="Customer" asp-controller="Cart" asp-action="Checkout" method="post">
                            <input type="hidden" name="selectedItems" id="selected-items" value="" />
                            <button type="submit" class="btn btn-success btn-lg px-4" id="checkout-button">
                                <i class="bi bi-credit-card me-2"></i> Mua Hàng
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .quantity-form .input-group {
        border-radius: 20px;
        overflow: hidden;
    }
    
    .quantity-form .form-control {
        height: 32px;
        font-weight: bold;
        border-left: none;
        border-right: none;
    }
    
    .quantity-form .btn {
        padding: 0 10px;
        border-color: #ced4da;
    }
</style>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Tham chiếu đến các phần tử DOM
            const selectAllCheckbox = document.getElementById('selectAll');
            const itemCheckboxes = document.querySelectorAll('.item-checkbox');
            const cartTotalPriceElement = document.getElementById('cart-total-price');
            
            // Xử lý chọn/bỏ chọn tất cả
            selectAllCheckbox.addEventListener('change', function() {
                const isChecked = this.checked;
                itemCheckboxes.forEach(checkbox => {
                    checkbox.checked = isChecked;
                });
                updateTotalPrice();
            });
            
            // Xử lý khi chọn/bỏ chọn từng sản phẩm
            itemCheckboxes.forEach(checkbox => {
                checkbox.addEventListener('change', function() {
                    updateSelectAllCheckbox();
                    updateTotalPrice();
                });
            });
            
            // Cập nhật checkbox chọn tất cả
            function updateSelectAllCheckbox() {
                const checkedCount = document.querySelectorAll('.item-checkbox:checked').length;
                const totalCount = itemCheckboxes.length;
                selectAllCheckbox.checked = (checkedCount === totalCount);
            }
            
            // Cập nhật tổng tiền
            function updateTotalPrice() {
                let total = 0;
                const checkedBoxes = document.querySelectorAll('.item-checkbox:checked');
                
                checkedBoxes.forEach(checkbox => {
                    const itemId = checkbox.value;
                    const itemRow = document.querySelector(`.cart-item-row[data-id='${itemId}']`);
                    if (itemRow) {
                        // Chuyển đổi chuỗi thành số và xử lý lỗi NaN
                        const price = parseFloat(itemRow.getAttribute('data-price')) || 0;
                        total += price;
                    }
                });
                
                // Định dạng tổng tiền theo định dạng tiền tệ Việt Nam
                cartTotalPriceElement.textContent = formatCurrency(total);
            }
            
            // Định dạng tiền tệ 
            function formatCurrency(amount) {
                return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(amount);
            }
            
            // Xử lý khi click nút thanh toán
            document.getElementById('checkout-form').addEventListener('submit', function(e) {
                const checkedBoxes = document.querySelectorAll('.item-checkbox:checked');
                const selectedItems = Array.from(checkedBoxes).map(checkbox => checkbox.value);
                
                if (selectedItems.length === 0) {
                    e.preventDefault();
                    alert("Vui lòng chọn ít nhất một sản phẩm để thanh toán");
                    return false;
                }
                
                // Cập nhật hidden input với danh sách ID sản phẩm đã chọn
                document.getElementById('selected-items').value = selectedItems.join(',');
                
                // Show loading indicator
                const checkoutButton = document.getElementById('checkout-button');
                checkoutButton.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Đang xử lý...';
                checkoutButton.disabled = true;
                return true;
            });
            
            // Khởi tạo tổng tiền ban đầu
            updateTotalPrice();
        });
    </script>
}
