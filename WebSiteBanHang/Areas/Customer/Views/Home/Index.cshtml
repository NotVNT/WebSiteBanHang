@model IEnumerable<WebSiteBanHang.Models.Product>
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    ViewData["Title"] = "Home Page";
}

<!-- Banner Scroll Start - now outside any container -->
<div class="banner-scroll-container">
    <div class="banner-scroll-wrapper">
        <div class="banner-scroll-item">
            <img src="~/banner-scroll-image/decor1.jpg" alt="Banner Image 1">
        </div>
        <div class="banner-scroll-item">
            <img src="~/banner-scroll-image/decor2.jpg" alt="Banner Image 2">
        </div>
        <div class="banner-scroll-item">
            <img src="~/banner-scroll-image/decor3.jpg" alt="Banner Image 3">
        </div>
        <div class="banner-scroll-item">
            <img src="~/banner-scroll-image/decor4.jpg" alt="Banner Image 4">
        </div>
        <div class="banner-scroll-item">
            <img src="~/banner-scroll-image/decor5.jpg" alt="Banner Image 5">
        </div>
    </div>
    
    <div class="banner-scroll-nav">
        <button class="banner-scroll-prev">
            <i class="bi bi-chevron-left"></i>
        </button>
        <button class="banner-scroll-next">
            <i class="bi bi-chevron-right"></i>
        </button>
    </div>
    
    <div class="banner-scroll-dots"></div>
</div>
<!-- Banner Scroll End -->

<!-- New Products Section -->
<div class="container-fluid px-4 mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary m-0">Sản Phẩm Mới Về</h2>
        <a href="@Url.Action("Index", "Product")" class="text-danger text-decoration-none">
            Xem Thêm <i class="bi bi-arrow-right"></i>
        </a>
    </div>
    
    <div class="row g-3">
        @foreach (var product in ViewBag.NewProducts)
        {
            <div class="col-6 col-md-4 col-lg-3 mb-3">
                <div class="card shadow-sm h-100 position-relative">
                    <!-- New Tag -->
                    <div class="position-absolute top-0 start-0">
                        <span class="badge bg-danger p-2">MỚI</span>
                    </div>
                    
                    <img src="@product.ImageUrl" class="card-img-top" alt="@product.Name" style="height: 200px; object-fit: cover;">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@product.Name</h5>
                        <p class="card-text flex-grow-1">@(product.Description?.Length > 60 ? product.Description.Substring(0, 60) + "..." : product.Description)</p>
                        <p class="card-text text-primary fw-bold">@product.Price.ToString("C0")</p>
                        <div class="d-flex justify-content-between">
                            <a asp-area="Customer" asp-controller="Product" asp-action="Display" 
                               asp-route-id="@product.Id" asp-route-isNew="true" 
                               class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-eye"></i> Chi tiết
                            </a>
                            
                            @if (SignInManager.IsSignedIn(User))
                            {
                                <button type="button" class="btn btn-success btn-sm add-to-cart-btn"
                                        data-product-id="@product.Id" 
                                        data-return-url="@Context.Request.Path@Context.Request.QueryString">
                                    <i class="bi bi-cart-plus"></i> Thêm vào giỏ
                                </button>
                            }
                            else
                            {
                                <a class="btn btn-success btn-sm" asp-area="Identity" asp-page="/Account/Login" 
                                   asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "Customer" })">
                                    <i class="bi bi-cart-plus"></i> Thêm vào giỏ
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Featured Products Section (already exists) -->
<div class="container-fluid px-4 mt-5">
    <h2 class="text-primary">Sản Phẩm Nổi Bật</h2>
    
    <div class="row g-3">
        @foreach (var product in Model)
        {
            <div class="col-md-3 mb-3">
                <div class="card shadow-sm h-100">
                    <img src="@product.ImageUrl" class="card-img-top" alt="@product.Name" style="height: 200px; object-fit: cover;">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@product.Name</h5>
                        <p class="card-text flex-grow-1">@(product.Description?.Length > 60 ? product.Description.Substring(0, 60) + "..." : product.Description)</p>
                        <p class="card-text text-primary fw-bold">@product.Price.ToString("C0")</p>
                        <div class="d-flex justify-content-between">
                            <a asp-area="Customer" asp-controller="Product" asp-action="Display" asp-route-id="@product.Id" 
                               class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-eye"></i> Chi tiết
                            </a>
                            
                            @if (SignInManager.IsSignedIn(User))
                            {
                                <button type="button" class="btn btn-success btn-sm add-to-cart-btn"
                                        data-product-id="@product.Id" 
                                        data-return-url="@Context.Request.Path@Context.Request.QueryString">
                                    <i class="bi bi-cart-plus"></i> Thêm vào giỏ
                                </button>
                            }
                            else
                            {
                                <a class="btn btn-success btn-sm" asp-area="Identity" asp-page="/Account/Login" 
                                   asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "Customer" })">
                                    <i class="bi bi-cart-plus"></i> Thêm vào giỏ
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
