@model WebSiteBanHang.Models.Order
@{
    ViewData["Title"] = "Chi tiết đơn hàng";
    
    var (statusClass, statusText) = Model.Status switch
    {
        OrderStatus.Pending => ("bg-warning text-dark", "Chờ xác nhận"),
        OrderStatus.Processing => ("bg-info text-dark", "Đang xử lý"),
        OrderStatus.Shipped => ("bg-primary", "Đang giao hàng"),
        OrderStatus.Delivered => ("bg-success", "Đã giao hàng"),
        OrderStatus.Cancelled => ("bg-danger", "Đã hủy"),
        _ => ("bg-secondary", "Không xác định")
    };
}

<div class="container mt-4 mb-5">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-area="Customer" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Đơn hàng của tôi</a></li>
            <li class="breadcrumb-item active">Chi tiết đơn hàng #@Model.Id</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-md-8">
            <!-- Thông tin sản phẩm -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-box-seam text-primary me-2"></i>Chi tiết sản phẩm
                        </h5>
                        <span class="badge @statusClass">@statusText</span>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Sản phẩm</th>
                                    <th class="text-center">Số lượng</th>
                                    <th class="text-end">Đơn giá</th>
                                    <th class="text-end">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                @if (!string.IsNullOrEmpty(item.Product.ImageUrl))
                                                {
                                                    <img src="@item.Product.ImageUrl" class="me-3" style="width: 50px; height: 50px; object-fit: cover;">
                                                }
                                                <div>
                                                    <h6 class="mb-0">@item.Product.Name</h6>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-center">@item.Quantity</td>
                                        <td class="text-end">@item.UnitPrice.ToString("C0")</td>
                                        <td class="text-end fw-bold">@item.TotalPrice.ToString("C0")</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-light">
                                <tr>
                                    <th colspan="3" class="text-end">Tổng cộng:</th>
                                    <th class="text-end text-primary">@Model.TotalAmount.ToString("C0")</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <!-- Thông tin đơn hàng -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-info-circle text-primary me-2"></i>Thông tin đơn hàng
                    </h5>
                </div>
                <div class="card-body">
                    <p class="mb-1 d-flex justify-content-between">
                        <span class="text-muted">Mã đơn hàng:</span>
                        <span class="fw-bold">#@Model.Id</span>
                    </p>
                    <p class="mb-1 d-flex justify-content-between">
                        <span class="text-muted">Ngày đặt hàng:</span>
                        <span>@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</span>
                    </p>
                    <p class="mb-1 d-flex justify-content-between">
                        <span class="text-muted">Phương thức thanh toán:</span>
                        <span>@Model.PaymentMethod</span>
                    </p>
                    <p class="mb-1 d-flex justify-content-between">
                        <span class="text-muted">Trạng thái:</span>
                        <span class="badge @statusClass">@statusText</span>
                    </p>
                </div>
            </div>

            <!-- Thông tin giao hàng -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-truck text-primary me-2"></i>Thông tin giao hàng
                    </h5>
                </div>
                <div class="card-body">
                    <p class="mb-1"><strong>Người nhận:</strong> @Model.FullName</p>
                    <p class="mb-1"><strong>Số điện thoại:</strong> @Model.PhoneNumber</p>
                    <p class="mb-1"><strong>Email:</strong> @Model.Email</p>
                    <p class="mb-1"><strong>Địa chỉ:</strong> @Model.ShippingAddress</p>
                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <p class="mb-1"><strong>Ghi chú:</strong> @Model.Notes</p>
                    }
                </div>
            </div>

            <div class="d-grid">
                <a asp-action="Index" class="btn btn-outline-primary">
                    <i class="bi bi-arrow-left me-2"></i>Quay lại danh sách đơn hàng
                </a>
            </div>
        </div>
    </div>
</div>
