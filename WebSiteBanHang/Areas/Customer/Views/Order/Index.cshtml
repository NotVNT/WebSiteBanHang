@model WebSiteBanHang.Models.ViewModels.PaginatedList<WebSiteBanHang.Models.Order>
@{
    ViewData["Title"] = "Đơn hàng của tôi";
    ViewData["ActivePage"] = "Orders";
}

<div class="container py-5">
    <h2 class="mb-4 fw-bold">
        <i class="bi bi-receipt me-2 text-primary"></i>Đơn hàng của tôi
    </h2>

    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-header bg-white py-3 border-0">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <h5 class="mb-md-0">Danh sách đơn hàng</h5>
                </div>
                <div class="col-md-6">
                    <form method="get" class="d-flex align-items-center justify-content-md-end">
                        <input type="hidden" name="page" value="1" />
                        <div class="input-group input-group-sm" style="max-width: 200px;">
                            <label class="input-group-text" for="statusFilter">
                                <i class="bi bi-funnel"></i>
                            </label>
                            <select asp-items="@ViewBag.StatusList" class="form-select" id="statusFilter" name="status" onchange="this.form.submit()">
                            </select>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        @if (Model.Items == null || !Model.Items.Any())
        {
            <div class="card-body text-center py-5">
                <i class="bi bi-receipt-cutoff text-muted" style="font-size: 3rem;"></i>
                <h4 class="mt-3 mb-2">Không tìm thấy đơn hàng nào</h4>
                <p class="text-muted mb-4">
                    @if (!string.IsNullOrEmpty(ViewBag.CurrentStatus))
                    {
                        <span>Không có đơn hàng nào ở trạng thái này.</span>
                    }
                    else
                    {
                        <span>Bạn chưa có đơn hàng nào. Hãy mua sắm để có những trải nghiệm tuyệt vời với sản phẩm của chúng tôi.</span>
                    }
                </p>
                @if (!string.IsNullOrEmpty(ViewBag.CurrentStatus))
                {
                    <a href="@Url.Action("Index")" class="btn btn-outline-primary me-2">
                        <i class="bi bi-arrow-repeat me-2"></i>Xem tất cả đơn hàng
                    </a>
                }
                <a href="@Url.Action("Index", "Home")" class="btn btn-primary">
                    <i class="bi bi-cart-plus me-2"></i>Mua sắm ngay
                </a>
            </div>
        }
        else
        {
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th>Mã đơn hàng</th>
                                <th>Ngày đặt</th>
                                <th class="text-end">Tổng tiền</th>
                                <th>Trạng thái</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model.Items)
                            {
                                <tr>
                                    <td>
                                        <strong>#@order.Id</strong>
                                    </td>
                                    <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="text-end">
                                        @if (order.DiscountAmount > 0)
                                        {
                                            <div class="d-flex flex-column align-items-end">
                                                <span class="text-decoration-line-through text-muted small">@((order.TotalAmount + order.DiscountAmount).ToString("C0"))</span>
                                                <span>@order.TotalAmount.ToString("C0")</span>
                                                <span class="badge bg-danger mt-1">-@order.DiscountAmount.ToString("C0")</span>
                                            </div>
                                        }
                                        else
                                        {
                                            @order.TotalAmount.ToString("C0")
                                        }
                                    </td>
                                    <td>
                                        @switch (order.Status)
                                        {
                                            case OrderStatus.Pending:
                                                <span class="badge bg-warning text-dark">Chờ xác nhận</span>
                                                break;
                                            case OrderStatus.Confirmed:
                                                <span class="badge bg-info text-dark">Đã xác nhận</span>
                                                break;
                                            case OrderStatus.Completed:
                                                <span class="badge bg-success">Đã hoàn thành</span>
                                                break;
                                            case OrderStatus.Cancelled:
                                                <span class="badge bg-danger">Đã hủy</span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary">@order.Status</span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a href="@Url.Action("Details", "Order", new { id = order.Id })" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-eye me-1"></i>Chi tiết
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @if (Model.TotalPages > 1)
            {
                <div class="card-footer bg-white border-0">
                    <nav aria-label="Page navigation">
                        <ul class="pagination justify-content-center mb-0">
                            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="1" asp-route-status="@ViewBag.CurrentStatus" aria-label="First">
                                    <span aria-hidden="true">&laquo;&laquo;</span>
                                </a>
                            </li>
                            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageIndex - 1)" asp-route-status="@ViewBag.CurrentStatus" aria-label="Previous">
                                    <span aria-hidden="true">&laquo;</span>
                                </a>
                            </li>

                            @{
                                var startPage = Math.Max(1, Model.PageIndex - 2);
                                var endPage = Math.Min(Model.TotalPages, Model.PageIndex + 2);

                                if (startPage > 1)
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">...</span>
                                    </li>
                                }

                                for (var i = startPage; i <= endPage; i++)
                                {
                                    <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                        <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-status="@ViewBag.CurrentStatus">@i</a>
                                    </li>
                                }

                                if (endPage < Model.TotalPages)
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">...</span>
                                    </li>
                                }
                            }

                            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageIndex + 1)" asp-route-status="@ViewBag.CurrentStatus" aria-label="Next">
                                    <span aria-hidden="true">&raquo;</span>
                                </a>
                            </li>
                            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@Model.TotalPages" asp-route-status="@ViewBag.CurrentStatus" aria-label="Last">
                                    <span aria-hidden="true">&raquo;&raquo;</span>
                                </a>
                            </li>
                        </ul>
                    </nav>
                    <div class="text-center mt-2">
                        <small class="text-muted">
                            Hiển thị @(((Model.PageIndex - 1) * Model.PageSize) + 1) đến @(Math.Min(Model.TotalItems, Model.PageIndex * Model.PageSize)) trong tổng số @Model.TotalItems đơn hàng
                        </small>
                    </div>
                </div>
            }
        }
    </div>
</div>
