@model IEnumerable<WebSiteBanHang.Models.Order>
@{
    ViewData["Title"] = "Đơn hàng của tôi";
    ViewData["ActivePage"] = "Orders";
}

<div class="container py-5">
    <h2 class="mb-4 fw-bold">
        <i class="bi bi-receipt me-2 text-primary"></i>Đơn hàng của tôi
    </h2>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-body text-center py-5">
                <i class="bi bi-receipt-cutoff text-muted" style="font-size: 3rem;"></i>
                <h4 class="mt-3 mb-2">Bạn chưa có đơn hàng nào</h4>
                <p class="text-muted mb-4">Hãy mua sắm để có những trải nghiệm tuyệt vời với sản phẩm của chúng tôi.</p>
                <a href="@Url.Action("Index", "Home")" class="btn btn-primary px-4 py-2">
                    <i class="bi bi-cart-plus me-2"></i>Mua sắm ngay
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-header bg-white py-3 border-0">
                <div class="row align-items-center">
                    <div class="col">
                        <h5 class="mb-0">Danh sách đơn hàng</h5>
                    </div>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th>Mã đơn hàng</th>
                                <th>Ngày đặt</th>
                                <th class="text-end">Tổng tiền</th>
                                <th>Trạng thái</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>#@order.Id</strong>
                                    </td>
                                    <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="text-end">@order.TotalAmount.ToString("C0")</td>
                                    <td>
                                        @switch (order.Status)
                                        {
                                            case OrderStatus.Pending:
                                                <span class="badge bg-warning text-dark">Chờ xác nhận</span>
                                                break;
                                            case OrderStatus.Processing:
                                                <span class="badge bg-info text-dark">Đã xác nhận</span>
                                                break;
                                            case OrderStatus.Completed:
                                                <span class="badge bg-success">Đã hoàn thành</span>
                                                break;
                                            case OrderStatus.Cancelled:
                                                <span class="badge bg-danger">Đã hủy</span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary">@order.Status</span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a href="@Url.Action("Details", "Order", new { id = order.Id })" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-eye me-1"></i>Chi tiết
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
