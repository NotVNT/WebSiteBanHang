@model WebSiteBanHang.Models.ViewModels.PaginatedList<WebSiteBanHang.Models.Product>
@{
    ViewData["Title"] = ViewBag.CategoryName != null ? ViewBag.CategoryName : "Sản phẩm";
}

<div class="container mt-4 mb-5">
    <div class="row">
        <!-- Sidebar with categories -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-grid me-2"></i>Danh mục sản phẩm
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush">
                        <a asp-action="Index" class="list-group-item list-group-item-action @(ViewBag.SelectedCategoryId == null ? "active" : "")">
                            <i class="bi bi-boxes me-2"></i>Tất cả sản phẩm
                        </a>
                        @foreach (var category in ViewBag.Categories)
                        {
                            <a asp-action="Index" asp-route-categoryId="@category.Id" 
                               class="list-group-item list-group-item-action @(ViewBag.SelectedCategoryId == category.Id ? "active" : "")">
                                <i class="bi bi-tag me-2"></i>@category.Name
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Main content with products -->
        <div class="col-md-9">
            <!-- Search Results Alert -->
            @if (!string.IsNullOrEmpty(ViewBag.SearchTerm as string))
            {
                <div class="alert alert-info mb-4">
                    <i class="bi bi-search me-2"></i>
                    @if (ViewBag.SearchResults > 0)
                    {
                        <span>Tìm thấy <strong>@ViewBag.SearchResults</strong> sản phẩm có tên chứa "<strong>@ViewBag.SearchTerm</strong>"</span>
                    }
                    else
                    {
                        <span>Không tìm thấy sản phẩm nào có tên chứa "<strong>@ViewBag.SearchTerm</strong>"</span>
                    }
                    <a href="@Url.Action("Index")" class="btn btn-sm btn-outline-secondary ms-2">
                        <i class="bi bi-x-circle"></i> Xóa tìm kiếm
                    </a>
                </div>
            }

            <!-- Category title or results heading -->
            <h2 class="mb-4">
                @if (!string.IsNullOrEmpty(ViewBag.SearchTerm as string))
                {
                    <span>Kết quả tìm kiếm</span>
                }
                else if (ViewBag.SelectedCategoryId != null)
                {
                    <span>@ViewBag.CategoryName</span>
                }
                else
                {
                    <span>Tất cả sản phẩm</span>
                }
            </h2>

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <span class="text-muted">Hiển thị @Model.Items.Count() trong tổng số @Model.TotalItems sản phẩm</span>
                </div>
            </div>
            
            @if (!Model.Items.Any())
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-2"></i>Không tìm thấy sản phẩm nào trong danh mục này.
                </div>
            }
            else
            {
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                    @foreach (var product in Model.Items)
                    {
                        <div class="col">
                            <div class="card h-100 border-0 shadow-sm product-card">
                                <div class="product-image-container">
                                    @if (!string.IsNullOrEmpty(product.ImageUrl))
                                    {
                                        <img src="@product.ImageUrl" class="card-img-top product-image" alt="@product.Name">
                                    }
                                    else
                                    {
                                        <img src="/images/no-image.png" class="card-img-top product-image" alt="No image">
                                    }
                                </div>
                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title product-name">@product.Name</h5>
                                    <p class="card-text description-text">@(product.Description?.Length > 80 ? product.Description.Substring(0, 80) + "..." : product.Description)</p>
                                    <div class="text-primary fw-bold fs-5 mt-auto">@product.Price.ToString("C0")</div>
                                </div>
                                <div class="card-footer bg-white border-0 pt-0">
                                    <div class="d-grid gap-2">
                                        <a asp-action="Display" asp-route-id="@product.Id" class="btn btn-outline-primary">
                                            <i class="bi bi-eye me-1"></i>Xem chi tiết
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                
                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Page navigation" class="mt-4">
                        <ul class="pagination justify-content-center">
                            <!-- First Page -->
                            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                                <a class="page-link" 
                                   asp-action="@(string.IsNullOrEmpty(ViewBag.SearchTerm as string) ? "Index" : "Search")" 
                                   asp-route-page="1" 
                                   asp-route-categoryId="@ViewBag.SelectedCategoryId"
                                   asp-route-searchTerm="@ViewBag.SearchTerm"
                                   aria-label="First">
                                    <span aria-hidden="true">&laquo;&laquo;</span>
                                </a>
                            </li>
                            
                            <!-- Previous Page -->
                            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                                <a class="page-link" 
                                   asp-action="@(string.IsNullOrEmpty(ViewBag.SearchTerm as string) ? "Index" : "Search")" 
                                   asp-route-page="@(Model.PageIndex - 1)" 
                                   asp-route-categoryId="@ViewBag.SelectedCategoryId"
                                   asp-route-searchTerm="@ViewBag.SearchTerm"
                                   aria-label="Previous">
                                    <span aria-hidden="true">&laquo;</span>
                                </a>
                            </li>

                            @{
                                var startPage = Math.Max(1, Model.PageIndex - 2);
                                var endPage = Math.Min(Model.TotalPages, Model.PageIndex + 2);
                                
                                // Show dots if not starting from first page
                                if (startPage > 1)
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">...</span>
                                    </li>
                                }
                                
                                // Page numbers
                                for (var i = startPage; i <= endPage; i++)
                                {
                                    <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                        <a class="page-link" 
                                           asp-action="@(string.IsNullOrEmpty(ViewBag.SearchTerm as string) ? "Index" : "Search")" 
                                           asp-route-page="@i" 
                                           asp-route-categoryId="@ViewBag.SelectedCategoryId"
                                           asp-route-searchTerm="@ViewBag.SearchTerm">@i</a>
                                    </li>
                                }
                                
                                // Show dots if not ending on last page
                                if (endPage < Model.TotalPages)
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">...</span>
                                    </li>
                                }
                            }

                            <!-- Next Page -->
                            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                                <a class="page-link" 
                                   asp-action="@(string.IsNullOrEmpty(ViewBag.SearchTerm as string) ? "Index" : "Search")" 
                                   asp-route-page="@(Model.PageIndex + 1)" 
                                   asp-route-categoryId="@ViewBag.SelectedCategoryId"
                                   asp-route-searchTerm="@ViewBag.SearchTerm"
                                   aria-label="Next">
                                    <span aria-hidden="true">&raquo;</span>
                                </a>
                            </li>
                            
                            <!-- Last Page -->
                            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                                <a class="page-link" 
                                   asp-action="@(string.IsNullOrEmpty(ViewBag.SearchTerm as string) ? "Index" : "Search")" 
                                   asp-route-page="@Model.TotalPages" 
                                   asp-route-categoryId="@ViewBag.SelectedCategoryId"
                                   asp-route-searchTerm="@ViewBag.SearchTerm"
                                   aria-label="Last">
                                    <span aria-hidden="true">&raquo;&raquo;</span>
                                </a>
                            </li>
                        </ul>
                    </nav>
                    
                    <div class="text-center mt-2 text-muted small">
                        Hiển thị @(((Model.PageIndex - 1) * Model.PageSize) + 1) đến @(Math.Min(Model.TotalItems, Model.PageIndex * Model.PageSize)) trong tổng số @Model.TotalItems sản phẩm
                    </div>
                }
            }
        </div>
    </div>
</div>

<style>
    .product-card {
        transition: transform 0.3s, box-shadow 0.3s;
    }
    
    .product-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
    }
    
    .product-image-container {
        height: 200px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        padding: 1rem;
    }
    
    .product-image {
        max-height: 100%;
        object-fit: contain;
    }
    
    .product-name {
        height: 3rem;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }
    
    .description-text {
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        font-size: 0.9rem;
        color: #6c757d;
    }
    
    .list-group-item.active {
        background-color: #0d6efd;
        border-color: #0d6efd;
    }
</style>
