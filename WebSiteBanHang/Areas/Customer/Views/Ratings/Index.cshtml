@model List<WebSiteBanHang.Models.Rating>
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager

<div class="container mt-5">
    <div class="row">
        <div class="col-md-12">
            <div class="card border-0 shadow-lg rounded-4">
                <div class="card-header bg-primary text-white p-4 border-0">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-star-fill fs-3 me-3"></i>
                        <h2 class="mb-0">Đánh giá của tôi</h2>
                    </div>
                </div>
                
                <div class="card-body p-4">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    
                    @if (Model.Count > 0)
                    {
                        <div class="row" id="ratings-list">
                            @foreach (var rating in Model)
                            {
                                <div class="col-md-6 mb-4">
                                    <div class="card h-100 border-0 shadow-sm hover-card">
                                        <div class="card-body">
                                            <div class="d-flex justify-content-between align-items-center mb-3">
                                                <h5 class="card-title mb-0 text-primary">
                                                    <a href="@Url.Action("Display", "Product", new { area = "Customer", id = rating.ProductId })" class="text-decoration-none">
                                                        @rating.Product.Name
                                                    </a>
                                                </h5>
                                                <div class="rating-stars">
                                                    @for (int i = 1; i <= 5; i++)
                                                    {
                                                        if (i <= rating.RatingValue)
                                                        {
                                                            <i class="bi bi-star-fill text-warning"></i>
                                                        }
                                                        else
                                                        {
                                                            <i class="bi bi-star text-warning"></i>
                                                        }
                                                    }
                                                </div>
                                            </div>
                                            
                                            <p class="card-text">@rating.Comment</p>
                                            
                                            <div class="d-flex justify-content-between align-items-center mt-3">
                                                <small class="text-muted">
                                                    <i class="bi bi-calendar3 me-1"></i>
                                                    @rating.DateCreated.ToString("dd/MM/yyyy HH:mm")
                                                </small>
                                                
                                                <form asp-action="Delete" asp-route-id="@rating.Id" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa đánh giá này không?')">
                                                    <button type="submit" class="btn btn-outline-danger btn-sm">
                                                        <i class="bi bi-trash me-1"></i> Xóa
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-star text-muted" style="font-size: 5rem;"></i>
                            <h4 class="mt-3">Bạn chưa có đánh giá nào</h4>
                            <p class="text-muted">Hãy mua sắm và đánh giá sản phẩm để giúp người khác có được lựa chọn tốt hơn</p>
                            <a asp-area="Customer" asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">
                                <i class="bi bi-shop me-2"></i> Mua sắm ngay
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .hover-card {
        transition: transform 0.2s, box-shadow 0.2s;
    }
    
    .hover-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
    }
    
    .rating-stars {
        font-size: 1.2rem;
    }
</style> 