@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Dữ liệu cá nhân";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<div class="container py-5">
    <div class="row">
        <div class="col-lg-4">
            <div class="card mb-4 border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center mx-auto mb-4" 
                         style="width: 100px; height: 100px; font-size: 3rem;">
                        <i class="bi bi-database-lock"></i>
                    </div>
                    <h5 class="card-title mb-3">Quản lý dữ liệu</h5>
                    <p class="card-text text-muted mb-3">Tài khoản của bạn chứa dữ liệu cá nhân mà bạn đã cung cấp cho chúng tôi. Trang này cho phép bạn tải xuống hoặc xóa dữ liệu đó.</p>
                    <div class="alert alert-warning border-0 shadow-sm">
                        <div class="d-flex">
                            <div class="me-3 fs-3">
                                <i class="bi bi-exclamation-triangle-fill text-warning"></i>
                            </div>
                            <div class="text-start">
                                <p class="mb-0"><strong>Lưu ý:</strong> Việc xóa dữ liệu sẽ xóa vĩnh viễn tài khoản của bạn và không thể khôi phục.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="card mb-4 mb-lg-0 border-0 shadow-sm">
                <div class="card-body p-0">
                    <partial name="_ManageNav" />
                </div>
            </div>
        </div>
        
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3 border-0">
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-person-badge text-primary me-2"></i>@ViewData["Title"]
                    </h5>
                </div>
                <div class="card-body p-4">
                    <p class="text-muted mb-4">
                        <i class="bi bi-info-circle me-2"></i>
                        Tài khoản của bạn bao gồm các dữ liệu cá nhân mà bạn đã cung cấp. Trên trang này, bạn có thể tải xuống hoặc xóa dữ liệu này.
                    </p>
                    
                    <div class="mb-4">
                        <a asp-page="./Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-2"></i>Quay lại Thông tin tài khoản
                        </a>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="card h-100 bg-light border-0">
                                <div class="card-body p-4">
                                    <h5 class="card-title fw-bold mb-3">
                                        <i class="bi bi-cloud-download text-success me-2"></i>Tải xuống
                                    </h5>
                                    <p class="card-text mb-4">
                                        Bạn có thể tải xuống dữ liệu cá nhân của mình ở định dạng JSON để xem các thông tin chúng tôi lưu trữ về bạn.
                                    </p>
                                    <form id="download-data" asp-page="DownloadPersonalData" method="post">
                                        <button class="btn btn-success" type="submit">
                                            <i class="bi bi-download me-2"></i>Tải xuống
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                        
                        <div class="col-md-6">
                            <div class="card h-100 bg-light border-0">
                                <div class="card-body p-4">
                                    <h5 class="card-title fw-bold mb-3">
                                        <i class="bi bi-trash text-danger me-2"></i>Xóa dữ liệu
                                    </h5>
                                    <p class="card-text mb-4">
                                        Xóa dữ liệu sẽ loại bỏ vĩnh viễn tài khoản của bạn, và không thể khôi phục sau đó.
                                    </p>
                                    <button class="btn btn-danger" type="button" data-bs-toggle="modal" data-bs-target="#deleteDataModal">
                                        <i class="bi bi-trash me-2"></i>Xóa
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Data Modal -->
<div class="modal fade" id="deleteDataModal" tabindex="-1" aria-labelledby="deleteDataModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white border-0">
                <h5 class="modal-title" id="deleteDataModalLabel">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Xác nhận xóa dữ liệu
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="text-center mb-4">
                    <div class="display-1 text-danger mb-3">
                        <i class="bi bi-shield-exclamation"></i>
                    </div>
                    <h4 class="mb-3">Bạn có chắc chắn muốn xóa dữ liệu của mình?</h4>
                    <p class="text-muted">
                        Thao tác này sẽ xóa vĩnh viễn tài khoản của bạn và không thể hoàn tác. Tất cả dữ liệu cá nhân của bạn sẽ bị xóa khỏi hệ thống của chúng tôi.
                    </p>
                </div>
                <form id="delete-user" asp-page="DeletePersonalData" method="post" class="pb-3">
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" />
                        <label asp-for="Input.Password" class="form-label">Mật khẩu</label>
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>
                    <div class="d-flex justify-content-end">
                        <button type="button" class="btn btn-outline-secondary me-2" data-bs-dismiss="modal">
                            <i class="bi bi-x-circle me-2"></i>Hủy
                        </button>
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash-fill me-2"></i>Xóa dữ liệu
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
