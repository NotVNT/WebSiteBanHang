@model int

<a class="nav-link text-white position-relative" asp-area="Customer" asp-controller="Cart" asp-action="Index">
    <i class="bi bi-cart3"></i> 
    <span>Giỏ hàng</span>
    @if (Model > 0)
    {
        <span class="badge rounded-pill bg-danger position-absolute" style="top: 0; right: -10px;">@Model</span>
    }
</a> 