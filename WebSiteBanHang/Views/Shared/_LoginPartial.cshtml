@using Microsoft.AspNetCore.Identity
@using WebSiteBanHang.Models
@using Microsoft.EntityFrameworkCore
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext DbContext

@{
    // Chuyển hướng về trang Customer/Home/Index sau khi đăng xuất
    var returnUrl = Url.Action("Index", "Home", new { area = "Customer" });

    // Get cart item count for logged in user
    int cartItemCount = 0;
    if (SignInManager.IsSignedIn(User))
    {
        var userId = UserManager.GetUserId(User);
        cartItemCount = DbContext.CartItems.Where(c => c.UserId == userId).Sum(c => c.Quantity);
    }
}

@if (SignInManager.IsSignedIn(User))
{
    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@returnUrl" method="post" id="logoutForm" class="navbar-right" onsubmit="return confirmLogout(event);">
        <ul class="navbar-nav">
            @if (!User.IsInRole("Admin"))
            {
                <li class="nav-item">
                    <a class="nav-link text-white" asp-area="Customer" asp-controller="Cart" asp-action="Index">
                        <i class="bi bi-cart3"></i>
                        <span>Giỏ hàng</span>
                        @if (cartItemCount > 0)
                        {
                            <span class="badge rounded-pill bg-danger">@cartItemCount</span>
                        }
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white" asp-area="Customer" asp-controller="Order" asp-action="Index">
                        <i class="bi bi-receipt"></i> Đơn hàng của tôi
                    </a>
                </li>
            }
            <li class="nav-item">
                <a class="nav-link text-white" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">
                    @{
                        var user = UserManager.GetUserAsync(User).Result;
                        var userName = user?.FullName ?? "User";
                    }
                    Hello @userName!
                </a>
            </li>
            <li class="nav-item">
                <button type="submit" class="nav-link btn btn-link text-white logout-btn">
                    <i class="bi bi-box-arrow-right me-1"></i> Đăng Xuất
                </button>
            </li>
        </ul>
    </form>

    <!-- Modal -->
    <div class="modal fade" id="logoutModal" tabindex="-1" aria-labelledby="logoutModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-gradient-danger text-white border-0">
                    <h5 class="modal-title" id="logoutModalLabel"><i class="bi bi-box-arrow-right me-2"></i>Xác nhận đăng xuất</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="text-center mb-4">
                        <i class="bi bi-question-circle text-warning" style="font-size: 3rem;"></i>
                    </div>
                    <p class="text-center fs-5">Bạn có chắc chắn muốn đăng xuất khỏi hệ thống?</p>
                    <p class="text-center text-muted small">Bạn sẽ cần đăng nhập lại để tiếp tục mua sắm.</p>
                </div>
                <div class="modal-footer bg-light border-0 d-flex justify-content-center">
                    <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">
                        <i class="bi bi-x-circle me-2"></i>Hủy
                    </button>
                    <button type="button" class="btn btn-danger px-4 ms-3" onclick="submitLogout()">
                        <i class="bi bi-box-arrow-right me-2"></i>Đăng Xuất
                    </button>
                </div>
            </div>
        </div>
    </div>

    <style>
        .bg-gradient-danger {
            background: linear-gradient(to right, #ff416c, #ff4b2b);
        }

        .modal-content {
            border-radius: 15px;
            overflow: hidden;
        }

        .modal .modal-header .btn-close:focus {
            box-shadow: none;
        }

        .modal.fade .modal-dialog {
            transition: transform .3s ease-out;
        }

        .logout-btn {
            transition: all 0.3s ease;
            border-radius: 5px;
            padding: 5px 10px;
        }

            .logout-btn:hover {
                background-color: rgba(255, 255, 255, 0.1);
                transform: translateY(-2px);
            }
    </style>

}
else
{
    <ul class="navbar-nav">
        <li class="nav-item">
            <a class="nav-link text-white" asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Url.Action("Index", "Cart", new { area = "Customer" })">
                <i class="bi bi-cart3"></i> Giỏ hàng
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-white auth-btn" asp-area="Identity" asp-page="/Account/Login">
                <i class="bi bi-box-arrow-in-right me-1"></i> Đăng Nhập
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-white auth-btn" asp-area="Identity" asp-page="/Account/Register">
                <i class="bi bi-person-plus me-1"></i> Đăng Ký
            </a>
        </li>
    </ul>

    <style>
        .auth-btn {
            transition: all 0.3s ease;
            border-radius: 5px;
            padding: 5px 10px;
            margin: 0 2px;
        }

            .auth-btn:hover {
                background-color: rgba(255, 255, 255, 0.1);
                transform: translateY(-2px);
            }
    </style>
}
